{
  "manifest_version": 3,
  "name": "ProtoBowl Voice",
  "version": "1.2.0",
  "description": "Natural voice reading paced to ProtoBowl's question reveal, with optional complete-sentence flow.",
  "permissions": ["storage"],
  "background": {"scripts": ["background.js"], "persistent": false},
  "action": {"default_title": "ProtoBowl Voice", "default_popup": "popup.html"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "browser_specific_settings": {"safari": {"strict_min_version": "18.0"}},
  "content_scripts": [
    {
      "matches": ["https://protobowl.com/*", "https://*.protobowl.com/*", "http://protobowl.com/*", "http://*.protobowl.com/*"],
      "js": ["bridge.js"], "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["https://protobowl.com/*", "https://*.protobowl.com/*", "http://protobowl.com/*", "http://*.protobowl.com/*"],
      "js": ["core.js", "speech.js", "content.js"], "run_at": "document_start"
    }
  ]
}
